@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<BL.Models.PatientDto>

@{
    ViewData["Title"] = "Patients";
}

<div class="container">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2>Patients</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Patient
            </a>
            <a asp-action="ExportToCsv" class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i> Export to CSV
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="mb-3">
                <form asp-action="Index" method="get" class="row g-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <input type="text" name="searchString" class="form-control"
                                   placeholder="Search by last name or OIB..."
                                   value="@ViewData["CurrentFilter"]" />
                            <button type="submit" class="btn btn-outline-secondary">
                                <i class="bi bi-search"></i>
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                        </div>
                    </div>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Patient Number</th>
                            <th>Name</th>
                            <th>OIB</th>
                            <th>Date of Birth</th>
                            <th>Gender</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td>@patient.PatientNumber</td>
                                <td>@patient.FirstName @patient.LastName</td>
                                <td>@patient.OIB</td>
                                <td>@patient.DateOfBirth.ToString("dd.MM.yyyy")</td>
                                <td>@patient.Gender</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@patient.Id"
                                       class="btn btn-outline-primary btn-sm" title="View Details">
                                        <i class="bi bi-file-text"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@patient.Id"
                                       class="btn btn-outline-secondary btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@patient.Id"
                                       class="btn btn-outline-danger btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No patients found.
                </div>
            }
        </div>
    </div>
</div>