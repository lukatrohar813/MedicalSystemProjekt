@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MedicalSystem.ViewModels.Examination.ExaminationDetailsViewModel

@{
    ViewData["Title"] = $"Examination Details - {Model.PatientName}";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Patient" asp-action="Index">Patients</a></li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.Examination.PatientId">
                            @Model.PatientName
                        </a>
                    </li>
                    <li class="breadcrumb-item active">Examination Details</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2>Examination Details</h2>
                    <h5 class="text-muted">Patient: @Model.PatientName</h5>
                </div>
                <div>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addImagesModal">
                        <i class="bi bi-plus-circle"></i> Add Images
                    </button>
                    <a asp-action="Edit" asp-route-id="@Model.Examination.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <!-- Examination Information -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Examination Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Type</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-secondary">@Model.Examination.ExaminationType</span>
                        </dd>

                        <dt class="col-sm-3">Date & Time</dt>
                        <dd class="col-sm-9">@Model.Examination.ExaminationDateTime</dd>

                        <dt class="col-sm-3">Notes</dt>
                        <dd class="col-sm-9">@Model.Examination.Notes</dd>
                    </dl>
                </div>
            </div>

            <!-- Examination Images -->
            @if (Model.Images.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Examination Images</h5>
                        <span class="badge bg-white text-dark">@Model.Images.Count images</span>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var image in Model.Images)
                            {
                                <div class="col-md-4">
                                    <div class="card h-100">
                                        <img src="~/examination-images/@image.ImagePath"
                                             class="card-img-top examination-image cursor-pointer"
                                             style="height: 200px; object-fit: cover;"
                                             data-bs-toggle="modal"
                                             data-bs-target="#imageModal"
                                             data-image-src="/examination-images/@image.ImagePath"
                                             alt="Examination Image">
                                        <div class="card-body p-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted">
                                                    @image.UploadDateTime
                                                </small>
                                                <form asp-action="DeleteImage" asp-route-id="@image.Id"
                                                      onsubmit="return confirm('Are you sure you want to delete this image?');"
                                                      method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No images have been uploaded for this examination.
                    <button type="button" class="btn btn-link" data-bs-toggle="modal" data-bs-target="#addImagesModal">
                        Add images now
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Image Viewer Modal -->
<div class="modal fade" id="imageModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Examination Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 text-center bg-light">
                <img src="" class="img-fluid" id="modalImage" alt="Full size examination image">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Images Modal -->
<div class="modal fade" id="addImagesModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddImages" asp-route-id="@Model.Examination.Id" enctype="multipart/form-data" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add Examination Images</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Images</label>
                        <input type="file" class="form-control" name="images" id="imageInput" multiple accept="image/*" required>
                        <div class="form-text">
                            You can select multiple images. Supported formats: JPG, PNG
                        </div>
                    </div>
                    <div id="imagePreview" class="row g-2">
                        <!-- Preview images will be shown here -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload Images</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imageInput').addEventListener('change', function(e) {
            const preview = document.getElementById('imagePreview');
            preview.innerHTML = '';

            Array.from(e.target.files).forEach(file => {
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        const col = document.createElement('div');
                        col.className = 'col-4';
                        col.innerHTML = `
                            <div class="card">
                                <img src="${event.target.result}" class="card-img-top"
                                     style="height: 100px; object-fit: cover;">
                            </div>
                        `;
                        preview.appendChild(col);
                    }
                    reader.readAsDataURL(file);
                }
            });
        });

        document.getElementById('imageModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const imageSrc = button.getAttribute('data-image-src');
            document.getElementById('modalImage').src = imageSrc;
        });
    </script>
}
