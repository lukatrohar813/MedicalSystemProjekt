@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MedicalSystem.ViewModels.Examination.ExaminationDeleteViewModel

@{
    ViewData["Title"] = "Delete Examination";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Patient" asp-action="Index">Patients</a></li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.PatientId">
                            @Model.PatientName
                        </a>
                    </li>
                    <li class="breadcrumb-item active">Delete Examination</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <h2>Delete Examination</h2>
            <h5 class="text-muted">Patient: @Model.PatientName</h5>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Confirm Deletion</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Are you sure you want to delete this examination record? This action cannot be undone.
                    </div>

                    <dl class="row mt-4">
                        <dt class="col-sm-3">Date & Time</dt>
                        <dd class="col-sm-9">@Model.ExaminationDateTime.</dd>

                        <dt class="col-sm-3">Type</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-secondary">@Model.ExaminationType</span>
                            @Model.GetExaminationTypeName()
                        </dd>

                        <dt class="col-sm-3">Notes</dt>
                        <dd class="col-sm-9">@Model.Notes</dd>

                        @if (Model.Images.Any())
                        {
                            <dt class="col-sm-3">Images</dt>
                            <dd class="col-sm-9">
                                <div class="row g-2">
                                    @foreach (var image in Model.Images)
                                    {
                                        <div class="col-md-4">
                                            <img src="~/examination-images/@image.ImagePath"
                                                 class="img-thumbnail"
                                                 alt="Examination Image" />
                                        </div>
                                    }
                                </div>
                            </dd>
                        }
                    </dl>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete Examination
                        </button>
                        <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.PatientId"
                           class="btn btn-secondary">
                            <i class="bi bi-x"></i> Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Warning</h5>
                </div>
                <div class="card-body">
                    <p>Deleting this examination will also:</p>
                    <ul>
                        <li>Remove all associated images</li>
                        <li>Delete all examination data permanently</li>
                        <li>Remove it from the patient's medical record</li>
                    </ul>
                    <p class="mb-0 text-danger">
                        <i class="bi bi-exclamation-circle"></i>
                        This action cannot be reversed.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>