@model MedicalSystem.ViewModels.Examination.ExaminationEditViewModel

@{
    ViewData["Title"] = $"Edit Examination - {Model.PatientName}";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Patient" asp-action="Index">Patients</a></li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.PatientId">
                            @Model.PatientName
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Details" asp-route-id="@Model.Id">Examination Details</a>
                    </li>
                    <li class="breadcrumb-item active">Edit Examination</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <h2>Edit Examination</h2>
            <h5 class="text-muted">Patient: @Model.PatientName</h5>
        </div>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-8">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="PatientId" />
                <input type="hidden" asp-for="PatientName" />

                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <h4 class="mb-0">Examination Information</h4>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="ExaminationType" class="form-label"></label>
                            <select asp-for="ExaminationType" class="form-select">
                                <option value="">Select examination type...</option>
                                @foreach (var type in Model.ExaminationTypes)
                                {
                                    <option value="@type.Code">@type.Name</option>
                                }
                            </select>
                            <span asp-validation-for="ExaminationType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
	                        <label asp-for="ExaminationDateTime" class="form-label">Date and Time</label>
                            <input asp-for="ExaminationDateTime" class="form-control datepicker" />
                            <span asp-validation-for="ExaminationDateTime" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Examination Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="5"
                                      placeholder="Enter detailed examination notes..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <h4 class="mb-0">Examination Images</h4>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <label class="form-label">Add New Images</label>
                            <input type="file" name="Images" multiple class="form-control" accept="image/*" />
                            <div class="form-text">
                                You can select multiple images. Supported formats: JPG, PNG, GIF
                            </div>
                        </div>

                        @if (Model.ExistingImages?.Any() == true)
                        {
                            <div class="mt-4">
                                <h5>Current Images</h5>
                                <div class="row g-3">
                                    @foreach (var image in Model.ExistingImages)
                                    {
                                        <div class="col-md-4">
                                            <div class="card">
                                                <img src="~/examination-images/@image.ImagePath"
                                                     class="card-img-top"
                                                     alt="Examination Image"
                                                     style="height: 150px; object-fit: cover;">
                                                <div class="card-body p-2">
                                                    <form asp-action="DeleteImage" asp-route-id="@image.Id"
                                                          onsubmit="return confirm('Delete this image?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm w-100">
                                                            Delete Image
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">Examination Types</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            @foreach (var type in Model.ExaminationTypes)
                            {
                                <div class="list-group-item">
                                    <h6 class="mb-1">@type.Name</h6>
                                    <small class="text-muted">Code: @type.Code</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>
         $(document).ready(function() {
        // Initialize datepicker
        $('.datepicker').datetimepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            todayHighlight: true,
            endDate: '0d'
        });

            // Image file validation and preview
            $('input[type="file"]').on('change', function() {
                console.log("File input triggered"); // Debugging log
                const maxFileSize = 5 * 1024 * 1024; // 5MB
                const files = Array.from(this.files);
                let hasInvalidFile = false;

                const previewContainer = $('<div class="image-preview-container"></div>');
                $(this).after(previewContainer);
                previewContainer.empty(); // Clear previous previews

                files.forEach(file => {
                    if (file.size > maxFileSize) {
                        hasInvalidFile = true;
                        alert(`File ${file.name} is too large. Maximum size is 5MB.`);
                    } else if (!file.type.startsWith('image/')) {
                        hasInvalidFile = true;
                        alert(`File ${file.name} is not an image.`);
                    } else {
                        // Create an image preview
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const img = $('<img>').attr('src', e.target.result).css({
                                width: '100px',
                                height: '100px',
                                margin: '5px',
                                objectFit: 'cover',
                                border: '1px solid #ddd',
                                borderRadius: '5px'
                            });
                            previewContainer.append(img);
                        };
                        reader.readAsDataURL(file);
                    }
                });

                if (hasInvalidFile) {
                    this.value = '';
                }
            });
    
    </script>
}
