@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MedicalSystem.ViewModels.MedicalHistory.MedicalHistoryCreateViewModel

@{
    ViewData["Title"] = "Add Medical History";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Patient" asp-action="Index">Patients</a></li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.PatientId">
                            @Model.PatientName
                        </a>
                    </li>
                    <li class="breadcrumb-item active">Add Medical History</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <h2>Add Medical History</h2>
            <h5 class="text-muted">Patient: @Model.PatientName</h5>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="PatientId" />
                <input type="hidden" asp-for="PatientName" />

                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="DiseaseName" class="form-label">Disease Name</label>
                            <input asp-for="DiseaseName" class="form-control" />
                            <span asp-validation-for="DiseaseName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StartDate" class="form-label">Start Date</label>
                            <input asp-for="StartDate" class="form-control" type="text" placeholder="dd/MM/yyyy" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EndDate" class="form-label">End Date (leave empty if ongoing)</label>
                            <input asp-for="EndDate" class="form-control" type="text" placeholder="dd/MM/yyyy" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.PatientId"
                               class="btn btn-secondary">Cancel</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Tips</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">📝 Enter the specific name of the disease or condition</li>
                        <li class="mb-2">📅 Use the date format dd/MM/yyyy</li>
                        <li class="mb-2">❗ Leave end date empty for ongoing conditions</li>
                        <li class="mb-2">✅ Dates must be in chronological order</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // Initialize datepicker
            $('input[placeholder="dd/MM/yyyy"]').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                endDate: '0d' // Restrict to past dates only
            });

            // Validate end date is after start date
            $('form').on('submit', function(e) {
                var startDate = new Date($('#StartDate').val().split('/').reverse().join('-'));
                var endDateStr = $('#EndDate').val();

                if (endDateStr) {
                    var endDate = new Date(endDateStr.split('/').reverse().join('-'));
                    if (endDate < startDate) {
                        e.preventDefault();
                        alert('End date must be after start date');
                        return false;
                    }
                }
            });
        });
    </script>
}