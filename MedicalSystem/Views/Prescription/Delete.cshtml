@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MedicalSystem.ViewModels.Prescription.PrescriptionDetailsViewModel

@{
    ViewData["Title"] = "Delete Prescription";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Patient" asp-action="Index">Patients</a></li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.PatientId">
                            @Model.PatientName
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Details" asp-route-id="@Model.Id">Prescription Details</a>
                    </li>
                    <li class="breadcrumb-item active">Delete Prescription</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <h2>Delete Prescription</h2>
            <h5 class="text-muted">Patient: @Model.PatientName</h5>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Confirm Deletion</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Are you sure you want to delete this prescription? This action cannot be undone.
                    </div>

                    <dl class="row mt-4">
                        <dt class="col-sm-3">Medicine Name</dt>
                        <dd class="col-sm-9">@Model.MedicineName</dd>

                        <dt class="col-sm-3">Dosage</dt>
                        <dd class="col-sm-9">@Model.Dosage</dd>

                        <dt class="col-sm-3">Date Prescribed</dt>
                        <dd class="col-sm-9">@Model.PrescriptionDate</dd>

                        <dt class="col-sm-3">Instructions</dt>
                        <dd class="col-sm-9">@Model.Instructions</dd>
                    </dl>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete Prescription
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                            <i class="bi bi-x"></i> Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">Warning</h5>
                </div>
                <div class="card-body">
                    <p>Deleting this prescription will:</p>
                    <ul>
                        <li>Remove it from the patient's medical record</li>
                        <li>Delete all prescription data permanently</li>
                        <li>This action cannot be reversed</li>
                    </ul>
                    <hr>
                    <p class="mb-0 text-danger">
                        <i class="bi bi-exclamation-circle"></i>
                        Make sure you have backed up any important information if needed.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>