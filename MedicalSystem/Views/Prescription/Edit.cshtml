
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MedicalSystem.ViewModels.Prescription.PrescriptionEditViewModel

@{
    ViewData["Title"] = "Edit Prescription";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Patient" asp-action="Index">Patients</a></li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.PatientId">
                            @Model.PatientName
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Details" asp-route-id="@Model.Id">Prescription Details</a>
                    </li>
                    <li class="breadcrumb-item active">Edit Prescription</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <h2>Edit Prescription</h2>
            <h5 class="text-muted">Patient: @Model.PatientName</h5>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="PatientId" />
                <input type="hidden" asp-for="PatientName" />

                <div class="card shadow-sm">
                    <div class="card-body">
	                    <div class="mb-3">
		                    <label asp-for="MedicineId" class="form-label">Medicine</label>
		                    <select asp-for="MedicineId" class="form-select" asp-items="@(new SelectList(Model.AvailableMedicines, "Id", "Name"))">
			                    <option value="">Select a medicine...</option>
		                    </select>
		                    <span asp-validation-for="MedicineId" class="text-danger"></span>
		                    <div class="mt-2">
			                    <a asp-controller="Medicine" asp-action="Create" class="btn btn-sm btn-outline-primary">
				                    <i class="bi bi-plus"></i> Add New Medicine
			                    </a>
		                    </div>
	                    </div>

                        <div class="mb-3">
                            <label asp-for="Dosage" class="form-label"></label>
                            <input asp-for="Dosage" class="form-control" />
                            <span asp-validation-for="Dosage" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PrescriptionDate" class="form-label"></label>
                            <input asp-for="PrescriptionDate" class="form-control" type="text"
                                   value="@DateTime.Now.ToString("dd-MM-yyyy")" />
                            <span asp-validation-for="PrescriptionDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Instructions" class="form-label"></label>
                            <textarea asp-for="Instructions" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Instructions" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Prescription Tips</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-3">
                            <i class="bi bi-capsule text-primary"></i>
                            <strong>Medicine Name:</strong> Use the full and correct name
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-clock text-primary"></i>
                            <strong>Dosage:</strong> Include amount and frequency
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-card-text text-primary"></i>
                            <strong>Instructions:</strong> Be clear and specific
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Example Formats</h5>
                </div>
                <div class="card-body">
                    <p><strong>Dosage examples:</strong></p>
                    <ul>
                        <li>1 tablet three times daily</li>
                        <li>5ml every 6 hours</li>
                        <li>2 capsules before bed</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

