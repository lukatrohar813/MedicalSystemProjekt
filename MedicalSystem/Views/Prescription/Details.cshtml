@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MedicalSystem.ViewModels.Prescription.PrescriptionDetailsViewModel

@{
    ViewData["Title"] = "Prescription Details";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Patient" asp-action="Index">Patients</a></li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.PatientId">
                            @Model.PatientName
                        </a>
                    </li>
                    <li class="breadcrumb-item active">Prescription Details</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <div>
                <h2>Prescription Details</h2>
                <h5 class="text-muted">Patient: @Model.PatientName</h5>
            </div>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Prescription Information</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Medicine Name</dt>
                        <dd class="col-sm-9">@Model.MedicineName</dd>

                        <dt class="col-sm-3">Dosage</dt>
                        <dd class="col-sm-9">@Model.Dosage</dd>

                        <dt class="col-sm-3">Date Prescribed</dt>
                        <dd class="col-sm-9">@Model.PrescriptionDate</dd>

                        <dt class="col-sm-3">Instructions</dt>
                        <dd class="col-sm-9">@Model.Instructions</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <a asp-controller="Patient"
                           asp-action="Details"
                           asp-route-id="@Model.PatientId"
                           class="list-group-item list-group-item-action">
                            <i class="bi bi-person"></i> Back to Patient Profile
                        </a>
                        <a asp-action="Create"
                           asp-route-patientId="@Model.PatientId"
                           class="list-group-item list-group-item-action">
                            <i class="bi bi-plus-circle"></i> Create New Prescription
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>